# Check the header format only. ComfyUI validates the username and password.
map $http_authorization $basic_auth_missing {
    default 1;
    "~*^Basic [A-Za-z0-9+/]+=*$" 0;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 100m;

    location / {
        if ($basic_auth_missing) {
            add_header WWW-Authenticate 'Basic realm="ComfyUI Server"' always;
            return 401;
        }

        # No URI suffix: preserve the original request path and query string.
        proxy_pass ${UPSTREAM_SCHEME}://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_set_header Host $proxy_host;

        # Overwrite both headers; never trust an incoming X-App-Authorization.
        proxy_set_header X-App-Authorization $http_authorization;
        proxy_set_header Authorization "Bearer ${UPSTREAM_TOKEN}";

        proxy_ssl_server_name on;
        proxy_ssl_name ${UPSTREAM_HOST};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;

        # ComfyUI WebSocket connections and long-running requests.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;

        # Preserve backend 401 responses and WWW-Authenticate challenges.
        proxy_intercept_errors off;
    }
}
