# Local browser entry: http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080

# Upstream origin only: no scheme, path, or port in UPSTREAM_HOST.
UPSTREAM_HOST=your-upstream.example.com
UPSTREAM_SCHEME=https
UPSTREAM_PORT=443

# Token only, without the "Bearer " prefix. Single quotes prevent interpolation.
UPSTREAM_TOKEN='replace-with-your-token'
